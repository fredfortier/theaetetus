{
  "name": "theaetetus-dialectical-evals",
  "private": true,
  "scripts": {
    "eval:prepare": "node evals/promptfoo/scripts/prepare-fixtures.mjs",
    "eval:calibrate": "promptfoo eval -c evals/promptfoo/promptfooconfig.calibration.yaml --no-cache",
    "eval:unit": "promptfoo eval -c evals/promptfoo/promptfooconfig.unit.yaml --no-cache",
    "eval:holdout": "promptfoo eval -c evals/promptfoo/promptfooconfig.holdout.yaml --no-cache",
    "eval:integration": "DIALECTIC_RUN_INDEX=0 promptfoo eval -c evals/promptfoo/promptfooconfig.integration.yaml --no-cache -j 1",
    "eval:dialectic": "node evals/promptfoo/scripts/run-all.mjs"
  },
  "devDependencies": {
    "@openai/codex-sdk": "0.149.0",
    "promptfoo": "0.122.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
